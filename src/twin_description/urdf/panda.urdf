    <parent link="world"/>
    <child link="panda_link0"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>

  <!-- ============================================================ -->
  <!-- S20 PERCEPTION: fixed overhead depth camera (eye-to-hand).    -->
  <!-- Rigid to `world`, looking straight down. world == panda_link0 -->
  <!-- (identity), so a point deprojected in world frame is already  -->
  <!-- in the frame resolve_object() returns. Sensor block is with   -->
  <!-- the other <gazebo> tags near the end of the file.             -->
  <!-- ============================================================ -->
  <link name="camera_link">
    <visual>
      <geometry><box size="0.05 0.05 0.05"/></geometry>
      <material name="cam_grey"><color rgba="0.1 0.1 0.1 1"/></material>
    </visual>
    <!-- no <collision>: the camera must never obstruct planning -->
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>
  <joint name="world_to_camera" type="fixed">
    <parent link="world"/>
    <child link="camera_link"/>
    <!-- 1.2 m up at (0.4,0,1.2), pitched 90deg so optical axis looks down -->
    <origin rpy="0 1.5708 0" xyz="0.4 0.0 1.2"/>
  </joint>
  <!-- Optical frame: REP-103 (Z fwd, X right, Y down). gz stamps image data
       in THIS frame; the detector deprojects here then maps to world. -->
  <link name="camera_optical_link"/>
  <joint name="camera_to_optical" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_link"/>
    <origin rpy="-1.5708 0 -1.5708" xyz="0 0 0"/>
  </joint>

