    </inertial>
  </link>

  <joint name="panda_finger_joint1" type="prismatic">
    <parent link="panda_hand"/>
    <child link="panda_leftfinger"/>
    <origin rpy="0 0 0" xyz="0 0 0.0584"/>
    <axis xyz="0 1 0"/>
    <limit effort="20" lower="0.0" upper="0.04" velocity="0.2"/>
    <dynamics damping="0.3"/>
  </joint>

  <joint name="panda_finger_joint2" type="prismatic">
    <parent link="panda_hand"/>
    <child link="panda_rightfinger"/>
    <origin rpy="0 0 0" xyz="0 0 0.0584"/>
    <axis xyz="0 -1 0"/>
    <limit effort="20" lower="0.0" upper="0.04" velocity="0.2"/>
    <!-- No <mimic> here: panda_finger_joint2 is DRIVEN by the JointTrajectory
         controller (commanded alongside joint1), not by a mimic constraint. A
         mimic joint may not also have a command_interface; gz_ros2_control
         aborts on load if both are present ("Activated mimic joints cannot have
         command interfaces"). The two fingers are kept in sync by the controller
         commanding both to the same value, not by this tag. -->
    <dynamics damping="0.3"/>
  </joint>

  <!-- ros2_control: interface contract for the 7 arm joints -->
  <ros2_control name="PandaSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="panda_joint1">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="panda_joint2">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="panda_joint3">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="panda_joint4">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="panda_joint5">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="panda_joint6">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="panda_joint7">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!--Add finger joints to ros2_control--> 
    <joint name="panda_finger_joint1">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- panda_finger_joint2 is a DIRECTLY COMMANDED joint (not a mimic). DART
         does not support mimic constraints (gz dropped it at runtime: "physics
         engine does not support mimic constraints"), so the right finger was left
         uncoupled -> asymmetric close, friction-only grip, box oscillation (S17).
         Root fix: drive BOTH fingers via a JointTrajectoryController over both
         joints, matching the real two-actuator Panda hand. So joint2 needs a
         command_interface here, and the URDF <mimic> tag on the joint has been
         REMOVED (a mimic joint may not also have a command_interface; gz aborts
         on load otherwise). The controller keeps the fingers in sync. -->
    <joint name="panda_finger_joint2">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

  </ros2_control>

  <!-- Single Gazebo system plugin: starts controller_manager inside the sim -->
  <gazebo>
    <plugin filename="gz_ros2_control-system"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>__PANDA_CONTROLLERS_YAML__</parameters>
    </plugin>
  </gazebo>
  <!-- S20 PERCEPTION: RGBD sensor on camera_link -> /overhead_camera topics -->
  <gazebo reference="camera_link">
    <sensor name="overhead_rgbd" type="rgbd_camera">
      <camera>
        <horizontal_fov>1.047</horizontal_fov>   <!-- 60 deg -->
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>3.0</far>
        </clip>
      </camera>
      <always_on>1</always_on>
      <update_rate>10</update_rate>
      <visualize>true</visualize>
      <topic>overhead_camera</topic>
      <gz_frame_id>camera_optical_link</gz_frame_id>
    </sensor>
  </gazebo>

</robot>