<?xml version="1.0" ?>
<!-- A2 sorting object: yellow cube. 3 cm grasp dimension in EVERY horizontal direction so
     the fixed top-down gripper seats at 0.015 whatever axis it closes along, keeping
     move_to's grasp plausibility gate (0.015 +/- 0.006) valid. Saturated colour so the
     HSV detector separates it from the low-saturation cell by construction. -->
<sdf version="1.8">
  <model name="yellow_cube">
    <static>false</static>
    <link name="link">
      <inertial><mass>0.05</mass>
        <inertia><ixx>1.3e-05</ixx><iyy>1.3e-05</iyy><izz>1.3e-05</izz>
                 <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="collision"><geometry><box><size>0.03 0.03 0.03</size></box></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="visual"><geometry><box><size>0.03 0.03 0.03</size></box></geometry>
        <material><ambient>0.85 0.72 0.05 1</ambient><diffuse>0.85 0.72 0.05 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
