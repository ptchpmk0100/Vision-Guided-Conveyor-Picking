<?xml version="1.0" ?>
<!-- B1 calibration target: a vivid-yellow 40x40x4 mm flat tile.  The material exactly
     matches obj_yellow_box so the established HSV class remains applicable. -->
<sdf version="1.8">
  <model name="obj_yellow_tile">
    <link name="tile_link">
      <inertial>
        <mass>0.01</mass>
        <inertia><ixx>1.3467e-6</ixx><ixy>0</ixy><ixz>0</ixz>
                 <iyy>1.3467e-6</iyy><iyz>0</iyz><izz>2.6667e-6</izz></inertia>
      </inertial>
      <collision name="collision">
        <geometry><box><size>0.04 0.04 0.004</size></box></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.04 0.04 0.004</size></box></geometry>
        <material><ambient>0.75 0.65 0.05 1</ambient><diffuse>0.90 0.80 0.08 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
      </visual>
    </link>
  </model>
</sdf>
