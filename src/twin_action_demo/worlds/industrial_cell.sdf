<?xml version="1.0" ?>
<!-- Tier-1 INDUSTRIAL CELL (scene dressing). sensors_empty + the verified functional
     core (3 ground bins at PLACE_SLOTS 0/2/3) + industrial visual dressing.
     World name stays "empty" (spawners / /world/empty/* tooling depend on it).

     INVARIANTS (so the verified pipeline does not regress):
       - Panda stays on the ground (z=0); objects rest at center z=0.015.
       - Overhead functional camera (panda.urdf) stays at (0.4,0,1.2); unchanged.
       - ALL dressing is <visual> only, NO <collision> -> the arm cannot touch it and
         physics is unaffected. Only the bins have collision (to contain cubes).
       - NO blue-dominant surface anywhere the camera sees (detector keys on blue).
         Reference's light-blue bin/sensors -> teal/gray here; markers red/green only. -->
<sdf version="1.8">
  <world name="empty">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows><pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse><specular>0.2 0.2 0.2 1</specular>
      <attenuation><range>1000</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <!-- NOTE: do NOT add fill lighting here. S21 measured the Panda hand's blue
         indicator dots at B-G <= 31 against the detector's B-G >= 36 threshold --
         only 5 units of headroom. An extra overhead light pushed those arm pixels
         into the blue mask, dragging the detected centroid ~29 mm toward the robot
         and causing an edge-grasp that reported success on an unmoved cube.
         Sun-only lighting, exactly as the verified worlds. -->

    <!-- industrial gray floor -->
    <model name="ground_plane"><static>true</static><link name="link">
      <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry></collision>
      <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        <material><ambient>0.30 0.30 0.32 1</ambient><diffuse>0.33 0.33 0.35 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
    </link></model>

    <!-- ===== FUNCTIONAL (collision kept): 3 steel collection bins at the slots ===== -->
    <!-- bin at PLACE_SLOT 0 -->
    <model name="bin_a"><static>true</static><pose>0.45 0.18 0 0 0 0</pose><link name="walls">
      <collision name="w_px"><pose>0.068 0 0.015 0 0 0</pose><geometry><box><size>0.004 0.14 0.03</size></box></geometry></collision>
      <collision name="w_nx"><pose>-0.068 0 0.015 0 0 0</pose><geometry><box><size>0.004 0.14 0.03</size></box></geometry></collision>
      <collision name="w_py"><pose>0 0.068 0.015 0 0 0</pose><geometry><box><size>0.14 0.004 0.03</size></box></geometry></collision>
      <collision name="w_ny"><pose>0 -0.068 0.015 0 0 0</pose><geometry><box><size>0.14 0.004 0.03</size></box></geometry></collision>
      <visual name="v_px"><pose>0.068 0 0.015 0 0 0</pose><geometry><box><size>0.004 0.14 0.03</size></box></geometry><material><ambient>0.55 0.56 0.6 1</ambient><diffuse>0.6 0.62 0.66 1</diffuse><specular>0.3 0.3 0.3 1</specular></material></visual>
      <visual name="v_nx"><pose>-0.068 0 0.015 0 0 0</pose><geometry><box><size>0.004 0.14 0.03</size></box></geometry><material><ambient>0.55 0.56 0.6 1</ambient><diffuse>0.6 0.62 0.66 1</diffuse></material></visual>
      <visual name="v_py"><pose>0 0.068 0.015 0 0 0</pose><geometry><box><size>0.14 0.004 0.03</size></box></geometry><material><ambient>0.55 0.56 0.6 1</ambient><diffuse>0.6 0.62 0.66 1</diffuse></material></visual>
      <visual name="v_ny"><pose>0 -0.068 0.015 0 0 0</pose><geometry><box><size>0.14 0.004 0.03</size></box></geometry><material><ambient>0.55 0.56 0.6 1</ambient><diffuse>0.6 0.62 0.66 1</diffuse></material></visual>
    </link></model>
    <!-- bin at PLACE_SLOT 2 -->
    <model name="bin_b"><static>true</static><pose>0.45 -0.18 0 0 0 0</pose><link name="walls">
      <collision name="w_px"><pose>0.068 0 0.015 0 0 0</pose><geometry><box><size>0.004 0.14 0.03</size></box></geometry></collision>
      <collision name="w_nx"><pose>-0.068 0 0.015 0 0 0</pose><geometry><box><size>0.004 0.14 0.03</size></box></geometry></collision>
      <collision name="w_py"><pose>0 0.068 0.015 0 0 0</pose><geometry><box><size>0.14 0.004 0.03</size></box></geometry></collision>
      <collision name="w_ny"><pose>0 -0.068 0.015 0 0 0</pose><geometry><box><size>0.14 0.004 0.03</size></box></geometry></collision>
      <visual name="v_px"><pose>0.068 0 0.015 0 0 0</pose><geometry><box><size>0.004 0.14 0.03</size></box></geometry><material><ambient>0.55 0.56 0.6 1</ambient><diffuse>0.6 0.62 0.66 1</diffuse></material></visual>
      <visual name="v_nx"><pose>-0.068 0 0.015 0 0 0</pose><geometry><box><size>0.004 0.14 0.03</size></box></geometry><material><ambient>0.55 0.56 0.6 1</ambient><diffuse>0.6 0.62 0.66 1</diffuse></material></visual>
      <visual name="v_py"><pose>0 0.068 0.015 0 0 0</pose><geometry><box><size>0.14 0.004 0.03</size></box></geometry><material><ambient>0.55 0.56 0.6 1</ambient><diffuse>0.6 0.62 0.66 1</diffuse></material></visual>
      <visual name="v_ny"><pose>0 -0.068 0.015 0 0 0</pose><geometry><box><size>0.14 0.004 0.03</size></box></geometry><material><ambient>0.55 0.56 0.6 1</ambient><diffuse>0.6 0.62 0.66 1</diffuse></material></visual>
    </link></model>
    <!-- bin at PLACE_SLOT 3 -->
    <model name="bin_c"><static>true</static><pose>0.37 0 0 0 0 0</pose><link name="walls">
      <collision name="w_px"><pose>0.068 0 0.015 0 0 0</pose><geometry><box><size>0.004 0.14 0.03</size></box></geometry></collision>
      <collision name="w_nx"><pose>-0.068 0 0.015 0 0 0</pose><geometry><box><size>0.004 0.14 0.03</size></box></geometry></collision>
      <collision name="w_py"><pose>0 0.068 0.015 0 0 0</pose><geometry><box><size>0.14 0.004 0.03</size></box></geometry></collision>
      <collision name="w_ny"><pose>0 -0.068 0.015 0 0 0</pose><geometry><box><size>0.14 0.004 0.03</size></box></geometry></collision>
      <visual name="v_px"><pose>0.068 0 0.015 0 0 0</pose><geometry><box><size>0.004 0.14 0.03</size></box></geometry><material><ambient>0.55 0.56 0.6 1</ambient><diffuse>0.6 0.62 0.66 1</diffuse></material></visual>
      <visual name="v_nx"><pose>-0.068 0 0.015 0 0 0</pose><geometry><box><size>0.004 0.14 0.03</size></box></geometry><material><ambient>0.55 0.56 0.6 1</ambient><diffuse>0.6 0.62 0.66 1</diffuse></material></visual>
      <visual name="v_py"><pose>0 0.068 0.015 0 0 0</pose><geometry><box><size>0.14 0.004 0.03</size></box></geometry><material><ambient>0.55 0.56 0.6 1</ambient><diffuse>0.6 0.62 0.66 1</diffuse></material></visual>
      <visual name="v_ny"><pose>0 -0.068 0.015 0 0 0</pose><geometry><box><size>0.14 0.004 0.03</size></box></geometry><material><ambient>0.55 0.56 0.6 1</ambient><diffuse>0.6 0.62 0.66 1</diffuse></material></visual>
    </link></model>

    <!-- ===== DRESSING (all visual-only, no collision) ===== -->
    <!-- robot pedestal: square base + round platform, flush at the floor (robot stays z=0) -->
    <model name="robot_pedestal"><static>true</static><pose>0 0 0 0 0 0</pose><link name="l">
      <visual name="base"><pose>0 0 0.01 0 0 0</pose><geometry><box><size>0.46 0.46 0.02</size></box></geometry><material><ambient>0.45 0.45 0.48 1</ambient><diffuse>0.5 0.5 0.53 1</diffuse></material></visual>
      <visual name="plat"><pose>0 0 0.025 0 0 0</pose><geometry><cylinder><radius>0.17</radius><length>0.05</length></cylinder></geometry><material><ambient>0.5 0.5 0.53 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse><specular>0.3 0.3 0.3 1</specular></material></visual>
    </link></model>

    <!-- main belt under the pick area: thin black strip (top ~z=0.001, no collision so the
         cube still rests on the ground plane at 0.015) + gray side rails + end rollers -->
    <model name="main_belt"><static>true</static><pose>0.5 0 0 0 0 0</pose><link name="l">
      <visual name="belt"><pose>0 0 0.001 0 0 0</pose><geometry><box><size>0.34 0.92 0.002</size></box></geometry><material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.07 0.07 0.07 1</diffuse></material></visual>
      <visual name="rail_py"><pose>0 0.47 0.035 0 0 0</pose><geometry><box><size>0.36 0.03 0.07</size></box></geometry><material><ambient>0.5 0.5 0.53 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material></visual>
      <visual name="rail_ny"><pose>0 -0.47 0.035 0 0 0</pose><geometry><box><size>0.36 0.03 0.07</size></box></geometry><material><ambient>0.5 0.5 0.53 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material></visual>
      <visual name="roller_py"><pose>0 0.47 0.04 1.5708 0 0</pose><geometry><cylinder><radius>0.035</radius><length>0.36</length></cylinder></geometry><material><ambient>0.3 0.3 0.32 1</ambient><diffuse>0.33 0.33 0.35 1</diffuse></material></visual>
    </link></model>

    <!-- feeder belt (foreground, cosmetic) with tan boxes on it -->
    <model name="feeder_belt"><static>true</static><pose>0.92 0 0.28 0 0 0</pose><link name="l">
      <visual name="belt"><pose>0 0 0 0 0 0</pose><geometry><box><size>0.28 1.6 0.03</size></box></geometry><material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.07 0.07 0.07 1</diffuse></material></visual>
      <visual name="rail_py"><pose>0 0.8 0.02 0 0 0</pose><geometry><box><size>0.3 0.03 0.1</size></box></geometry><material><ambient>0.5 0.5 0.53 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material></visual>
      <visual name="rail_ny"><pose>0 -0.8 0.02 0 0 0</pose><geometry><box><size>0.3 0.03 0.1</size></box></geometry><material><ambient>0.5 0.5 0.53 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material></visual>
      <visual name="leg1"><pose>0 0.7 -0.14 0 0 0</pose><geometry><box><size>0.04 0.04 0.28</size></box></geometry><material><ambient>0.4 0.4 0.43 1</ambient><diffuse>0.45 0.45 0.48 1</diffuse></material></visual>
      <visual name="leg2"><pose>0 -0.7 -0.14 0 0 0</pose><geometry><box><size>0.04 0.04 0.28</size></box></geometry><material><ambient>0.4 0.4 0.43 1</ambient><diffuse>0.45 0.45 0.48 1</diffuse></material></visual>
      <visual name="box1"><pose>0 0.45 0.04 0 0 0.2</pose><geometry><box><size>0.09 0.09 0.06</size></box></geometry><material><ambient>0.62 0.47 0.30 1</ambient><diffuse>0.70 0.53 0.34 1</diffuse></material></visual>
      <visual name="box2"><pose>0 0.05 0.04 0 0 -0.1</pose><geometry><box><size>0.09 0.09 0.06</size></box></geometry><material><ambient>0.62 0.47 0.30 1</ambient><diffuse>0.70 0.53 0.34 1</diffuse></material></visual>
      <visual name="box3"><pose>0 -0.5 0.04 0 0 0.35</pose><geometry><box><size>0.09 0.09 0.06</size></box></geometry><material><ambient>0.62 0.47 0.30 1</ambient><diffuse>0.70 0.53 0.34 1</diffuse></material></visual>
    </link></model>

    <!-- teal collection tray accent (left), cosmetic -->
    <model name="collection_tray"><static>true</static><pose>0.2 0.45 0 0 0 0</pose><link name="l">
      <visual name="base"><pose>0 0 0.01 0 0 0</pose><geometry><box><size>0.22 0.16 0.02</size></box></geometry><material><ambient>0.1 0.42 0.42 1</ambient><diffuse>0.12 0.48 0.48 1</diffuse></material></visual>
      <visual name="w1"><pose>0.11 0 0.05 0 0 0</pose><geometry><box><size>0.01 0.16 0.08</size></box></geometry><material><ambient>0.1 0.42 0.42 1</ambient><diffuse>0.12 0.48 0.48 1</diffuse></material></visual>
      <visual name="w2"><pose>-0.11 0 0.05 0 0 0</pose><geometry><box><size>0.01 0.16 0.08</size></box></geometry><material><ambient>0.1 0.42 0.42 1</ambient><diffuse>0.12 0.48 0.48 1</diffuse></material></visual>
      <visual name="w3"><pose>0 0.08 0.05 0 0 0</pose><geometry><box><size>0.22 0.01 0.08</size></box></geometry><material><ambient>0.1 0.42 0.42 1</ambient><diffuse>0.12 0.48 0.48 1</diffuse></material></visual>
      <visual name="w4"><pose>0 -0.08 0.05 0 0 0</pose><geometry><box><size>0.22 0.01 0.08</size></box></geometry><material><ambient>0.1 0.42 0.42 1</ambient><diffuse>0.12 0.48 0.48 1</diffuse></material></visual>
    </link></model>

    <!-- electrical cabinet behind the robot (out of camera footprint, x<-0.1) -->
    <model name="cabinet"><static>true</static><pose>-0.5 0 0 0 0 0</pose><link name="l">
      <visual name="body"><pose>0 0 0.55 0 0 0</pose><geometry><box><size>0.35 0.6 1.1</size></box></geometry><material><ambient>0.42 0.42 0.45 1</ambient><diffuse>0.47 0.47 0.5 1</diffuse></material></visual>
      <visual name="grille"><pose>0.18 0 0.75 0 0 0</pose><geometry><box><size>0.01 0.4 0.4</size></box></geometry><material><ambient>0.2 0.2 0.22 1</ambient><diffuse>0.22 0.22 0.24 1</diffuse></material></visual>
    </link></model>

    <!-- overhead sensor arm carrying the (functional) camera: post at y=0.8 + horizontal beam to (0.4,0,1.2) -->
    <model name="camera_arm"><static>true</static><pose>0.4 0 0 0 0 0</pose><link name="l">
      <visual name="post"><pose>0 0.82 0.6 0 0 0</pose><geometry><box><size>0.06 0.06 1.2</size></box></geometry><material><ambient>0.45 0.45 0.48 1</ambient><diffuse>0.5 0.5 0.53 1</diffuse></material></visual>
      <visual name="beam"><pose>0 0.42 1.21 0 0 0</pose><geometry><box><size>0.05 0.86 0.05</size></box></geometry><material><ambient>0.45 0.45 0.48 1</ambient><diffuse>0.5 0.5 0.53 1</diffuse></material></visual>
      <visual name="ring"><pose>0 0.78 0.35 1.5708 0 0</pose><geometry><cylinder><radius>0.09</radius><length>0.03</length></cylinder></geometry><material><ambient>0.55 0.35 0.2 1</ambient><diffuse>0.6 0.4 0.22 1</diffuse></material></visual>
    </link></model>

    <!-- safety fencing (visual-only), back + right, outside camera footprint -->
    <model name="fence_back"><static>true</static><pose>-0.35 0 0 0 0 0</pose><link name="l">
      <visual name="top"><pose>0 0 1.1 0 0 0</pose><geometry><box><size>0.03 1.8 0.04</size></box></geometry><material><ambient>0.5 0.5 0.53 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material></visual>
      <visual name="bot"><pose>0 0 0.05 0 0 0</pose><geometry><box><size>0.03 1.8 0.04</size></box></geometry><material><ambient>0.5 0.5 0.53 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material></visual>
      <visual name="b1"><pose>0 -0.75 0.55 0 0 0</pose><geometry><box><size>0.02 0.02 1.1</size></box></geometry><material><ambient>0.5 0.5 0.53 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material></visual>
      <visual name="b2"><pose>0 -0.45 0.55 0 0 0</pose><geometry><box><size>0.02 0.02 1.1</size></box></geometry><material><ambient>0.5 0.5 0.53 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material></visual>
      <visual name="b3"><pose>0 -0.15 0.55 0 0 0</pose><geometry><box><size>0.02 0.02 1.1</size></box></geometry><material><ambient>0.5 0.5 0.53 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material></visual>
      <visual name="b4"><pose>0 0.15 0.55 0 0 0</pose><geometry><box><size>0.02 0.02 1.1</size></box></geometry><material><ambient>0.5 0.5 0.53 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material></visual>
      <visual name="b5"><pose>0 0.45 0.55 0 0 0</pose><geometry><box><size>0.02 0.02 1.1</size></box></geometry><material><ambient>0.5 0.5 0.53 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material></visual>
      <visual name="b6"><pose>0 0.75 0.55 0 0 0</pose><geometry><box><size>0.02 0.02 1.1</size></box></geometry><material><ambient>0.5 0.5 0.53 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material></visual>
    </link></model>
    <model name="fence_right"><static>true</static><pose>0.5 -0.9 0 0 0 1.5708</pose><link name="l">
      <visual name="top"><pose>0 0 1.1 0 0 0</pose><geometry><box><size>0.03 1.8 0.04</size></box></geometry><material><ambient>0.5 0.5 0.53 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material></visual>
      <visual name="bot"><pose>0 0 0.05 0 0 0</pose><geometry><box><size>0.03 1.8 0.04</size></box></geometry><material><ambient>0.5 0.5 0.53 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material></visual>
      <visual name="b1"><pose>0 -0.6 0.55 0 0 0</pose><geometry><box><size>0.02 0.02 1.1</size></box></geometry><material><ambient>0.5 0.5 0.53 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material></visual>
      <visual name="b2"><pose>0 -0.2 0.55 0 0 0</pose><geometry><box><size>0.02 0.02 1.1</size></box></geometry><material><ambient>0.5 0.5 0.53 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material></visual>
      <visual name="b3"><pose>0 0.2 0.55 0 0 0</pose><geometry><box><size>0.02 0.02 1.1</size></box></geometry><material><ambient>0.5 0.5 0.53 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material></visual>
      <visual name="b4"><pose>0 0.6 0.55 0 0 0</pose><geometry><box><size>0.02 0.02 1.1</size></box></geometry><material><ambient>0.5 0.5 0.53 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material></visual>
    </link></model>

    <!-- red/green detection markers along the main belt edge (visual-only) -->
    <model name="marker_red"><static>true</static><pose>0.5 0.3 0.01 0 0 0</pose><link name="l">
      <visual name="v"><geometry><box><size>0.015 0.12 0.004</size></box></geometry><material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.9 0.12 0.12 1</diffuse></material></visual></link></model>
    <model name="marker_green"><static>true</static><pose>0.65 -0.2 0.01 0 0 0</pose><link name="l">
      <visual name="v"><geometry><box><size>0.015 0.12 0.004</size></box></geometry><material><ambient>0.1 0.7 0.1 1</ambient><diffuse>0.12 0.8 0.12 1</diffuse></material></visual></link></model>

    <!-- yellow floor safety stripe, rear-right -->
    <model name="floor_stripe"><static>true</static><pose>0.0 -0.6 0.002 0 0 0.6</pose><link name="l">
      <visual name="v"><geometry><box><size>0.5 0.06 0.002</size></box></geometry><material><ambient>0.85 0.72 0.1 1</ambient><diffuse>0.9 0.78 0.12 1</diffuse></material></visual></link></model>

  </world>
</sdf>
