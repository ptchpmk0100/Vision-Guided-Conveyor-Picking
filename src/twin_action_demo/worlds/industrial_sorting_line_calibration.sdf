<?xml version="1.0" ?>
<!-- B1 eye-to-hand calibration world.  The camera is still supplied by the Panda URDF
     at world (0.4, 0, 1.2); this world deliberately changes neither camera parameters
     nor lighting.  It replaces production trays and labels with a neutral platform so
     every saturated connected component is a calibration target.

     Invariants:
       - world name remains "empty" for /world/empty/* tooling;
       - sun-only lighting, identical to the verified sorting-line world;
       - no blue geometry;
       - platform top z=0.295; three pedestal tops z=0.345;
       - flat 4 mm calibration tiles are spawned at rest height by
         sorting_line_extrinsic_calibration.launch.py. -->
<sdf version="1.8">
  <world name="empty">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows><pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse><specular>0.2 0.2 0.2 1</specular>
      <attenuation><range>1000</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <!-- Do not add fill lights: calibration must reproduce production illumination. -->

    <model name="ground_plane"><static>true</static><link name="link">
      <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry></collision>
      <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        <material><ambient>0.30 0.30 0.32 1</ambient><diffuse>0.33 0.33 0.35 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
    </link></model>

    <!-- Neutral calibration platform: x=0.300..0.610, y=-0.200..+0.200. -->
    <model name="calibration_platform"><static>true</static><pose>0.455 0 0 0 0 0</pose><link name="l">
      <collision name="top"><pose>0 0 0.275 0 0 0</pose><geometry><box><size>0.310 0.400 0.040</size></box></geometry></collision>
      <visual name="top_v"><pose>0 0 0.275 0 0 0</pose><geometry><box><size>0.310 0.400 0.040</size></box></geometry>
        <material><ambient>0.38 0.38 0.40 1</ambient><diffuse>0.42 0.42 0.44 1</diffuse><specular>0.05 0.05 0.05 1</specular></material></visual>
      <visual name="leg1"><pose>-0.125 -0.170 0.1275 0 0 0</pose><geometry><box><size>0.035 0.035 0.255</size></box></geometry><material><ambient>0.35 0.35 0.37 1</ambient><diffuse>0.40 0.40 0.42 1</diffuse></material></visual>
      <visual name="leg2"><pose>-0.125 0.170 0.1275 0 0 0</pose><geometry><box><size>0.035 0.035 0.255</size></box></geometry><material><ambient>0.35 0.35 0.37 1</ambient><diffuse>0.40 0.40 0.42 1</diffuse></material></visual>
      <visual name="leg3"><pose>0.125 -0.170 0.1275 0 0 0</pose><geometry><box><size>0.035 0.035 0.255</size></box></geometry><material><ambient>0.35 0.35 0.37 1</ambient><diffuse>0.40 0.40 0.42 1</diffuse></material></visual>
      <visual name="leg4"><pose>0.125 0.170 0.1275 0 0 0</pose><geometry><box><size>0.035 0.035 0.255</size></box></geometry><material><ambient>0.35 0.35 0.37 1</ambient><diffuse>0.40 0.40 0.42 1</diffuse></material></visual>
    </link></model>

    <!-- Three 50 mm neutral pedestals.  Their tops are z=0.345. -->
    <model name="cal_pedestal_10"><static>true</static><pose>0.4175 -0.075 0 0 0 0</pose><link name="l">
      <collision name="c"><pose>0 0 0.320 0 0 0</pose><geometry><box><size>0.060 0.060 0.050</size></box></geometry></collision>
      <visual name="v"><pose>0 0 0.320 0 0 0</pose><geometry><box><size>0.060 0.060 0.050</size></box></geometry><material><ambient>0.46 0.46 0.48 1</ambient><diffuse>0.50 0.50 0.52 1</diffuse></material></visual>
    </link></model>
    <model name="cal_pedestal_11"><static>true</static><pose>0.5125 -0.075 0 0 0 0</pose><link name="l">
      <collision name="c"><pose>0 0 0.320 0 0 0</pose><geometry><box><size>0.060 0.060 0.050</size></box></geometry></collision>
      <visual name="v"><pose>0 0 0.320 0 0 0</pose><geometry><box><size>0.060 0.060 0.050</size></box></geometry><material><ambient>0.46 0.46 0.48 1</ambient><diffuse>0.50 0.50 0.52 1</diffuse></material></visual>
    </link></model>
    <model name="cal_pedestal_12"><static>true</static><pose>0.4175 0.075 0 0 0 0</pose><link name="l">
      <collision name="c"><pose>0 0 0.320 0 0 0</pose><geometry><box><size>0.060 0.060 0.050</size></box></geometry></collision>
      <visual name="v"><pose>0 0 0.320 0 0 0</pose><geometry><box><size>0.060 0.060 0.050</size></box></geometry><material><ambient>0.46 0.46 0.48 1</ambient><diffuse>0.50 0.50 0.52 1</diffuse></material></visual>
    </link></model>

    <!-- Low-saturation camera gantry dressing, matching the production cell. -->
    <model name="camera_arm"><static>true</static><pose>0.4 0 0 0 0 0</pose><link name="l">
      <visual name="post"><pose>0 0.82 0.6 0 0 0</pose><geometry><box><size>0.06 0.06 1.2</size></box></geometry><material><ambient>0.45 0.45 0.48 1</ambient><diffuse>0.5 0.5 0.53 1</diffuse></material></visual>
      <visual name="beam"><pose>0 0.42 1.21 0 0 0</pose><geometry><box><size>0.05 0.86 0.05</size></box></geometry><material><ambient>0.45 0.45 0.48 1</ambient><diffuse>0.5 0.5 0.53 1</diffuse></material></visual>
    </link></model>
  </world>
</sdf>
